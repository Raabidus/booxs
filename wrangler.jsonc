{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booxs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OWNER_EMAIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "booxs",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "local": {
      "name": "booxs-local",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "local",
        "OWNER_EMAIL": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "booxs",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
